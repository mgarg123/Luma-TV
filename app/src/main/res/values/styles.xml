<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Mi Clean Launcher -->
    <style name="Theme.MiCleanLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowOverscan">true</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Sleek Dark Dialog Theme for TV Inputs selection -->
    <style name="Theme.MiCleanLauncher.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/accent</item>
    </style>
</resources>
