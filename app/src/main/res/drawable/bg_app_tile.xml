<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card_focused" />
            <stroke android:width="@dimen/tile_focus_stroke_width" android:color="@color/focus_stroke" />
            <corners android:radius="@dimen/tile_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <stroke android:width="1dp" android:color="#242934" />
            <corners android:radius="@dimen/tile_corner_radius" />
        </shape>
    </item>
</selector>

